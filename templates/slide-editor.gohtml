{{define "meta-robots"}}<meta name="robots" content="noindex, nofollow" />{{end}}
{{template "modern-header" .}}

<!-- The deck's settings (title, slug, cover, categories, description, password, publish) above the
     DeckCraft editor, which edits the deck file itself. -->
<style>
  .slide-meta-strip { display:flex; align-items:center; gap:10px; padding:8px 14px; background:var(--surface); border-bottom:1px solid var(--border-light); flex-wrap:wrap; }
  .slide-meta-strip input[type="text"] { padding:5px 8px; border:1px solid var(--border); border-radius:4px; font-size:13px; background:var(--bg-primary); color:var(--text-primary); }
  .slide-meta-strip .meta-title { flex:2 1 240px; min-width:160px; font-weight:600; }
  .slide-meta-strip .meta-slug { flex:1 1 180px; min-width:120px; font-family:ui-monospace,monospace; font-size:12px; }
  .slide-meta-strip .meta-pub { display:flex; align-items:center; gap:6px; font-size:12px; color:var(--text-secondary); cursor:pointer; user-select:none; }
  .slide-meta-strip .meta-cover { width:36px; height:24px; border-radius:3px; object-fit:cover; border:1px solid var(--border); display:inline-block; vertical-align:middle; background:var(--bg-tertiary); }
  .slide-meta-strip .meta-toggle { padding:4px 10px; font-size:12px; font-weight:500; background:var(--bg-primary); border:1px solid var(--border); border-radius:4px; cursor:pointer; color:var(--text-primary); }
  .slide-meta-strip .meta-toggle:hover { background:var(--bg-tertiary); }
  .slide-meta-drawer { display:none; padding:14px; background:var(--surface); border-bottom:1px solid var(--border-light); }
  .slide-meta-drawer.open { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:14px; }
  .slide-meta-drawer label { display:block; font-size:11px; font-weight:600; color:var(--text-tertiary); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:4px; }
  .slide-meta-drawer input[type="text"], .slide-meta-drawer input[type="password"], .slide-meta-drawer textarea { width:100%; padding:6px 8px; border:1px solid var(--border); border-radius:4px; font-size:13px; background:var(--bg-primary); color:var(--text-primary); box-sizing:border-box; }
  .slide-meta-drawer .cat-list { display:flex; flex-wrap:wrap; gap:8px; max-height:120px; overflow-y:auto; padding:6px 8px; border:1px solid var(--border); border-radius:4px; background:var(--bg-primary); }
  .slide-meta-drawer .cat-list label { display:flex; align-items:center; gap:5px; text-transform:none; letter-spacing:normal; font-weight:400; font-size:12px; color:var(--text-primary); margin:0; cursor:pointer; }
  .meta-cover-row { display:flex; align-items:center; gap:8px; }
  .meta-cover-row .meta-cover-preview { width:60px; height:38px; border-radius:4px; object-fit:cover; background:var(--bg-tertiary); border:1px solid var(--border); }
  .meta-cover-row button { font-size:11px; padding:4px 8px; }
</style>
<form id="slide-form" method="POST" action="/admin/slides/{{.Slide.ID}}" style="height:calc(100vh - 64px);overflow:auto;display:flex;flex-direction:column">
  {{csrfField}}
  <input type="hidden" name="metadata" value="{{.Slide.SlideMetadata}}">

  <div class="slide-meta-strip">
    <input type="text" name="title" class="meta-title" value="{{.Slide.Title}}" placeholder="Slide title" required>
    <input type="text" name="slug" class="meta-slug" value="{{.Slide.Slug}}" placeholder="auto-generated">
    <label class="meta-pub" title="Publish on the public site">
      <input type="hidden" name="is_published" id="meta-pub-hidden" value="{{if .Slide.IsPublished}}on{{else}}false{{end}}">
      <input type="checkbox" id="meta-pub-checkbox" {{if .Slide.IsPublished}}checked{{end}}>
      Published
    </label>
    {{if .Slide.FeaturedImageURL}}<img class="meta-cover" src="{{.Slide.FeaturedImageURL}}" alt="cover" id="meta-cover-thumb">{{end}}
    <button type="button" class="meta-toggle" id="meta-toggle">Settings ▾</button>
  </div>

  <div class="slide-meta-drawer" id="meta-drawer">
    <div>
      <label for="meta-description">Description</label>
      <textarea id="meta-description" name="description" rows="3" placeholder="Brief description shown on /slides">{{.Slide.Description}}</textarea>
    </div>
    <div>
      <label for="meta-cover-url">Cover Image</label>
      <div class="meta-cover-row">
        <img class="meta-cover-preview" src="{{if .Slide.FeaturedImageURL}}{{.Slide.FeaturedImageURL}}{{else}}data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='60' height='38'/>{{end}}" id="meta-cover-preview" alt="cover">
        <input type="text" id="meta-cover-url" name="featured_image_url" value="{{.Slide.FeaturedImageURL}}" placeholder="/static/uploads/featured/...">
      </div>
      <div class="meta-cover-actions" style="display:flex;gap:6px;margin-top:6px;align-items:center;flex-wrap:wrap">
        <input type="file" id="meta-cover-file" accept="image/*" style="display:none">
        <button type="button" id="meta-cover-upload-btn" class="meta-toggle">Upload</button>
        <span id="meta-cover-drop" style="flex:1;min-width:140px;border:1px dashed #cbd5e1;border-radius:4px;padding:6px 8px;font-size:11px;color:#64748b;text-align:center;cursor:pointer">drop image here</span>
        {{if .Slide.FeaturedImageURL}}<button type="button" id="meta-cover-remove" class="meta-toggle" style="color:#ef4444">Remove</button>{{end}}
        <span id="meta-cover-status" style="font-size:11px;color:#64748b"></span>
      </div>
    </div>
    <div>
      <label>Categories</label>
      <div class="cat-list">
        {{range .Categories}}
          {{$catID := .ID}}
          <label><input type="checkbox" class="meta-cat" value="{{.ID}}" {{range $.Slide.Categories}}{{if eq .ID $catID}}checked{{end}}{{end}}> {{.Name}}</label>
        {{end}}
      </div>
      <input type="hidden" name="categories" id="meta-categories" value="{{range $i, $c := .Slide.Categories}}{{if $i}},{{end}}{{$c.ID}}{{end}}">
    </div>
    <div>
      <label for="meta-password">Password (optional)</label>
      <input type="password" id="meta-password" name="password" placeholder="{{if .Slide.PasswordHash}}leave blank to keep current{{else}}leave blank for public{{end}}">
    </div>
  </div>

  <div style="flex:1;min-height:0;display:flex;flex-direction:column">
    <!-- DeckCraft deck: the vendored web build (static/vendor/deckcraft) edits the stored file
         over its ?host=parent bridge. Save in DeckCraft stores the deck; this form's button
         saves only the settings above. -->
    <div class="slide-meta-strip" style="justify-content:space-between">
      <span id="deck-status" style="font-size:12px;color:var(--text-secondary,#64748b)">{{if .Slide.DeckName}}{{.Slide.DeckName}}{{else}}New deck: use Save in DeckCraft (Ctrl+S) to store it{{end}}</span>
      <button type="submit" class="meta-toggle">Save settings</button>
    </div>
    <iframe id="deckcraft-frame" title="DeckCraft editor"
            src="/static/vendor/deckcraft/index.html?host=parent&author={{.Username}}"
            allow="fullscreen; clipboard-read; clipboard-write" allowfullscreen
            style="flex:1;min-height:0;width:100%;border:0"></iframe>
    <script src="/static/js/deckcraft-fonts.js?v=1"></script>
    <script>
    (function() {
      var frame = document.getElementById('deckcraft-frame');
      var status = document.getElementById('deck-status');
      var slideID = {{.Slide.ID}}, slug = {{.Slide.Slug}}, deckName = {{.Slide.DeckName}};
      var csrf = (document.querySelector('input[name="gorilla.csrf.Token"]') || {}).value || '';
      var dirty = false;
      window.addEventListener('beforeunload', function(e) { if (dirty) e.preventDefault(); });

      function download(name, bytes) {
        var a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([bytes]));
        a.download = name;
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function() { URL.revokeObjectURL(a.href); }, 10000);
      }

      window.addEventListener('message', function(e) {
        var m = e.data;
        if (e.source !== frame.contentWindow || e.origin !== location.origin || !m || typeof m.type !== 'string') return;
        if (m.type === 'deckcraft:ready') {
          var fonts = window.deckcraftFonts(frame.contentWindow.deckcraft);
          if (!deckName) return; // new deck: DeckCraft starts empty and its first Save names the file
          fonts.then(function() { return fetch('/slides/' + encodeURIComponent(slug) + '/deck', { credentials: 'same-origin' }); })
            .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.arrayBuffer(); })
            .then(function(bytes) { frame.contentWindow.postMessage({ type: 'deckcraft:open', name: deckName, bytes: bytes }, location.origin, [bytes]); })
            .catch(function(err) { status.textContent = 'Could not load the deck: ' + err.message; });
        } else if (m.type === 'deckcraft:dirty') {
          dirty = !!m.dirty;
        } else if (m.type === 'deckcraft:failed') {
          status.textContent = 'DeckCraft could not start: ' + m.error;
        } else if (m.type === 'deckcraft:save') {
          // Only Save, or Save As to a presentation format, replaces the stored deck;
          // exports (PDF, pictures, a .pptx copy of a .deckcraft deck) are downloads.
          var isDeck = /\.(pptx|deckcraft)$/i.test(m.name);
          if (!isDeck || !(m.saveAs || m.name === deckName)) { download(m.name, m.bytes); return; }
          status.textContent = 'Saving ' + m.name + '…';
          fetch('/admin/slides/' + slideID + '/deck?name=' + encodeURIComponent(m.name), {
            method: 'POST', body: m.bytes, credentials: 'same-origin', headers: { 'X-CSRF-Token': csrf }
          }).then(function(r) {
            if (!r.ok) return r.text().then(function(t) { throw new Error(t || ('HTTP ' + r.status)); });
            deckName = m.name;
            status.textContent = 'Saved ' + m.name + ' at ' + new Date().toLocaleTimeString();
          }).catch(function(err) { dirty = true; status.textContent = 'Save failed: ' + err.message; });
        }
      });
    })();
    </script>
  </div>
</form>
<script>
(function() {
  // Drawer toggle
  var toggleBtn = document.getElementById('meta-toggle');
  var drawer = document.getElementById('meta-drawer');
  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', function() {
      var open = drawer.classList.toggle('open');
      toggleBtn.textContent = open ? 'Settings ▴' : 'Settings ▾';
    });
  }

  // is_published checkbox <-> hidden input. Server expects "on" / "false".
  var pubCb = document.getElementById('meta-pub-checkbox');
  var pubHidden = document.getElementById('meta-pub-hidden');
  if (pubCb && pubHidden) {
    pubCb.addEventListener('change', function() {
      pubHidden.value = pubCb.checked ? 'on' : 'false';
    });
  }

  // Cover URL <-> preview
  var coverUrl = document.getElementById('meta-cover-url');
  var coverPreview = document.getElementById('meta-cover-preview');
  var coverThumb = document.getElementById('meta-cover-thumb');
  if (coverUrl) {
    coverUrl.addEventListener('input', function() {
      var url = coverUrl.value.trim();
      if (coverPreview) coverPreview.src = url || coverPreview.src;
      if (coverThumb) coverThumb.src = url;
    });
  }

  // Category checkboxes -> hidden CSV
  var catHidden = document.getElementById('meta-categories');
  if (catHidden) {
    document.querySelectorAll('.meta-cat').forEach(function(cb) {
      cb.addEventListener('change', function() {
        var ids = Array.from(document.querySelectorAll('.meta-cat:checked')).map(function(x) { return x.value; });
        catHidden.value = ids.join(',');
      });
    });
  }

  // Cover image upload (file picker + drag-drop). POSTs to /admin/uploads
  // with type=featured + slug so the asset lands in
  // static/uploads/featured/<slug>/<hash>.ext, mirroring v1 behavior.
  var coverFile = document.getElementById('meta-cover-file');
  var coverUploadBtn = document.getElementById('meta-cover-upload-btn');
  var coverDrop = document.getElementById('meta-cover-drop');
  var coverRemove = document.getElementById('meta-cover-remove');
  var coverStatus = document.getElementById('meta-cover-status');
  var slugInput = document.querySelector('input[name="slug"]');

  function applyCoverUrl(url) {
    if (coverUrl) coverUrl.value = url;
    if (coverPreview) coverPreview.src = url || coverPreview.src;
    if (coverThumb) coverThumb.src = url;
  }

  function uploadCover(file) {
    if (!file || !file.type || !file.type.startsWith('image/')) {
      if (coverStatus) coverStatus.textContent = 'not an image';
      return;
    }
    if (coverStatus) coverStatus.textContent = 'uploading…';
    var fd = new FormData();
    fd.append('file', file);
    var qs = 'type=featured';
    if (slugInput && slugInput.value) qs += '&slug=' + encodeURIComponent(slugInput.value);
    fetch('/admin/uploads?' + qs, { method: 'POST', body: fd, credentials: 'same-origin' })
      .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function(data) {
        if (data && data.url) {
          applyCoverUrl(data.url);
          if (coverStatus) coverStatus.textContent = 'uploaded';
        } else {
          if (coverStatus) coverStatus.textContent = 'no url returned';
        }
      })
      .catch(function(err) {
        if (coverStatus) coverStatus.textContent = 'failed: ' + err.message;
      });
  }

  if (coverUploadBtn && coverFile) {
    coverUploadBtn.addEventListener('click', function() { coverFile.click(); });
    coverFile.addEventListener('change', function() {
      if (coverFile.files && coverFile.files[0]) uploadCover(coverFile.files[0]);
    });
  }
  if (coverDrop) {
    ['dragenter','dragover'].forEach(function(ev) {
      coverDrop.addEventListener(ev, function(e) { e.preventDefault(); coverDrop.style.borderColor = '#6366f1'; coverDrop.style.color = '#6366f1'; });
    });
    ['dragleave','drop'].forEach(function(ev) {
      coverDrop.addEventListener(ev, function() { coverDrop.style.borderColor = '#cbd5e1'; coverDrop.style.color = '#64748b'; });
    });
    coverDrop.addEventListener('drop', function(e) {
      e.preventDefault();
      var file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (file) uploadCover(file);
    });
    coverDrop.addEventListener('click', function() { if (coverFile) coverFile.click(); });
  }
  if (coverRemove) {
    coverRemove.addEventListener('click', function() {
      applyCoverUrl('');
      if (coverThumb && coverThumb.parentNode) coverThumb.parentNode.removeChild(coverThumb);
      coverRemove.style.display = 'none';
      if (coverStatus) coverStatus.textContent = 'cleared';
    });
  }
})();
</script>

{{template "modern-footer" .}}
