{{define "meta-robots"}}<meta name="robots" content="noindex, nofollow" />{{end}}
{{template "modern-header" .}}

<style>
.post-row { cursor: pointer; }
#versionModal { display: none; }
#versionModal.open { display: flex; }

.col-toggle-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.8125rem;
    color: var(--text-primary);
    cursor: pointer;
    white-space: nowrap;
}
.col-toggle-label:hover { background: var(--bg-tertiary); }
.col-toggle-label input { cursor: pointer; accent-color: var(--accent); }
[data-col-td="slug"].col-hidden { display: none; }
</style>

<div class="admin-page">
    <!-- Header -->
    <div class="admin-header">
        <div class="admin-header-text">
            <h1>Post Management</h1>
            <p>Create, edit, and organize blog posts</p>
        </div>
        <div class="admin-header-actions">
            <a href="/" class="admin-btn-secondary">
                {{icon "external-link" "w-4 h-4"}}
                View Site
            </a>
            <a href="/admin/posts/new" class="admin-btn-primary">
                {{icon "plus" "w-4 h-4"}}
                New Post
            </a>
        </div>
    </div>

    <!-- Stats -->
    <div class="admin-stats">
        <div class="admin-stat-card">
            <p class="admin-stat-label">Total</p>
            <p class="admin-stat-value">{{len .Posts.Posts}}</p>
        </div>
        <div class="admin-stat-card">
            <p class="admin-stat-label">Published</p>
            <p class="admin-stat-value is-green">
                {{$pub := 0}}{{range .Posts.Posts}}{{if .IsPublished}}{{$pub = add $pub 1}}{{end}}{{end}}{{$pub}}
            </p>
        </div>
        <div class="admin-stat-card">
            <p class="admin-stat-label">Draft</p>
            <p class="admin-stat-value is-amber">
                {{$dft := 0}}{{range .Posts.Posts}}{{if not .IsPublished}}{{$dft = add $dft 1}}{{end}}{{end}}{{$dft}}
            </p>
        </div>
    </div>

    <!-- Posts Table Card -->
    <div class="admin-card">
        <!-- Toolbar -->
        <div class="admin-toolbar">
            <div class="admin-search-wrap">
                <span class="admin-search-icon">{{icon "search" "w-4 h-4"}}</span>
                <input id="searchInput" type="search" placeholder="Search by title, slug, author…" class="admin-input">
            </div>

            <!-- Column visibility picker -->
            <div style="position:relative;" id="colPickerWrapper">
                <button type="button" onclick="toggleColPicker()" class="admin-btn-secondary">
                    {{icon "columns" "w-4 h-4"}}
                    Columns
                </button>
                <div id="colPickerMenu" class="hidden admin-dropdown-panel">
                    <p style="font-size:0.6875rem;font-weight:600;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.06em;margin:0 0 0.5rem 0.25rem;">Show / hide columns</p>
                    <label class="col-toggle-label" data-col="authors"><input type="checkbox" class="col-toggle" data-col="authors" checked> Author(s)</label>
                    <label class="col-toggle-label" data-col="categories"><input type="checkbox" class="col-toggle" data-col="categories" checked> Categories</label>
                    <label class="col-toggle-label" data-col="status"><input type="checkbox" class="col-toggle" data-col="status" checked> Status</label>
                    <label class="col-toggle-label" data-col="created"><input type="checkbox" class="col-toggle" data-col="created" checked> Created</label>
                    <label class="col-toggle-label" data-col="slug"><input type="checkbox" class="col-toggle" data-col="slug" checked> Slug</label>
                </div>
            </div>

            {{if .IsAdmin}}
            <button type="button" id="bulkDeleteBtn" class="hidden admin-btn-danger" onclick="confirmBulkDelete()">
                {{icon "trash" "w-4 h-4"}}
                Delete selected
            </button>
            {{end}}
        </div>

        {{if .Posts.Posts}}
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        {{if .IsAdmin}}<th scope="col" class="w-10">
                            <input type="checkbox" id="selectAll" class="admin-checkbox" onchange="toggleAllSelection()">
                        </th>{{end}}
                        <th scope="col">Post</th>
                        <th scope="col" data-col-th="authors">Author(s)</th>
                        <th scope="col" data-col-th="categories">Categories</th>
                        <th scope="col" data-col-th="status">Status</th>
                        <th scope="col" data-col-th="created">Created</th>
                        <th scope="col" class="is-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="postsTableBody">
                    {{range .Posts.Posts}}
                    <tr class="post-row" data-post-id="{{.ID}}" data-edit-url="/admin/posts/{{.ID}}/edit" data-searchable="{{.Title}} {{.Slug}} {{.AuthorDisplayName}}">
                        {{if $.IsAdmin}}<td onclick="event.stopPropagation()">
                            <input type="checkbox" class="post-checkbox admin-checkbox" value="{{.ID}}" onchange="updateBulkDeleteButton()">
                        </td>{{end}}
                        <td class="admin-title-cell">
                            <div class="admin-title-link" title="{{.Title}}">{{.Title}}</div>
                            <div data-col-td="slug" class="admin-subtext">/blog/{{.Slug}}</div>
                        </td>
                        <td data-col-td="authors" class="admin-secondary-cell">
                            {{$authorID := .UserID}}
                            <div style="font-weight:500;color:var(--text-primary);">{{.AuthorDisplayName}}</div>
                            {{range .Contributors}}
                                {{if ne .UserID $authorID}}
                                <div class="inline-flex items-center gap-1 mt-1 text-xs" style="color:var(--accent);">
                                    {{icon "edit" "w-3 h-3"}}
                                    {{.FullName}}
                                </div>
                                {{end}}
                            {{end}}
                        </td>
                        <td data-col-td="categories">
                            <div class="admin-badge-list">
                                {{range .Categories}}
                                <span class="admin-badge admin-badge-accent">{{.Name}}</span>
                                {{end}}
                                {{if not .Categories}}<span class="admin-muted">&mdash;</span>{{end}}
                            </div>
                        </td>
                        <td data-col-td="status">
                            {{if .IsPublished}}
                            <span class="admin-badge admin-badge-published">
                                <span class="admin-badge-dot"></span>
                                Published
                            </span>
                            {{else}}
                            <span class="admin-badge admin-badge-draft">
                                <span class="admin-badge-dot"></span>
                                Draft
                            </span>
                            {{end}}
                        </td>
                        <td data-col-td="created" class="admin-num">
                            {{.PublicationDate}}
                        </td>
                        <td class="is-right" onclick="event.stopPropagation()">
                            <div class="admin-actions">
                                <button type="button" class="admin-icon-btn" title="Version history" data-post-id="{{.ID}}" data-post-title="{{.Title}}" onclick="openVersionHistory(this)">
                                    {{icon "clock" "w-4 h-4"}}
                                </button>
                                <a class="admin-icon-btn" title="View post" href="/blog/{{.Slug}}" target="_blank">
                                    {{icon "eye" "w-4 h-4"}}
                                </a>
                                <a class="admin-icon-btn" title="Edit post" href="/admin/posts/{{.ID}}/edit">
                                    {{icon "edit" "w-4 h-4"}}
                                </a>
                                {{if $.IsAdmin}}
                                <button type="button" class="admin-icon-btn danger" title="Delete post" onclick="deleteSinglePost({{.ID}})">
                                    {{icon "trash" "w-4 h-4"}}
                                </button>
                                {{end}}
                            </div>
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="admin-empty">
            <div class="admin-empty-icon">{{icon "document" "w-10 h-10"}}</div>
            <h3>No posts yet</h3>
            <p>Get started by creating your first blog post.</p>
            <a href="/admin/posts/new" class="admin-btn-primary">
                {{icon "plus" "w-4 h-4"}}
                New Post
            </a>
        </div>
        {{end}}
    </div>
</div>

<!-- ── Delete Modal ── -->
<div id="deleteModal" class="admin-modal-backdrop hidden">
    <div class="admin-modal" onclick="event.stopPropagation()">
        <div class="admin-modal-header">
            <h3 id="modalTitle">Delete post?</h3>
            <button type="button" class="admin-icon-btn" onclick="closeDeleteModal()" aria-label="Close">
                {{icon "close" "w-5 h-5"}}
            </button>
        </div>
        <div class="admin-modal-body">
            <p id="modalMessage" class="text-sm" style="color:var(--text-secondary);margin:0;">This action cannot be undone.</p>
        </div>
        <div class="admin-modal-footer">
            <button type="button" onclick="closeDeleteModal()" class="admin-btn-secondary">Cancel</button>
            <button type="button" id="confirmDeleteBtn" class="admin-btn-danger">Delete</button>
        </div>
    </div>
</div>

<!-- ── Version History Modal ── -->
<div id="versionModal" class="admin-modal-backdrop" onclick="closeVersionModal()">
    <div class="admin-modal" style="max-width:28rem;max-height:80vh;display:flex;flex-direction:column;" onclick="event.stopPropagation()">
        <div class="admin-modal-header shrink-0">
            <div class="min-w-0 pr-4">
                <h2>Version History</h2>
                <p id="versionModalSubtitle" class="text-xs mt-0.5 truncate" style="color:var(--text-tertiary);margin-bottom:0;"></p>
            </div>
            <button type="button" onclick="closeVersionModal()" class="admin-icon-btn shrink-0" aria-label="Close">
                {{icon "close" "w-5 h-5"}}
            </button>
        </div>
        <div id="versionList" class="overflow-y-auto flex-1 px-5 py-4 space-y-2.5">
            <div class="flex items-center justify-center py-8">
                <svg class="animate-spin h-5 w-5" style="color:var(--accent);" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                </svg>
            </div>
        </div>
    </div>
</div>

<script>
const isAdmin = {{if .IsAdmin}}true{{else}}false{{end}};

// ── Row click → edit ──
document.querySelectorAll('.post-row').forEach(row => {
    row.addEventListener('click', () => window.location.href = row.dataset.editUrl);
});

// ── Search ──
document.getElementById('searchInput').addEventListener('input', function() {
    const q = this.value.toLowerCase();
    document.querySelectorAll('.post-row').forEach(row => {
        row.style.display = row.dataset.searchable.toLowerCase().includes(q) ? '' : 'none';
    });
});

// ── Multi-select ──
function toggleAllSelection() {
    const sel = document.getElementById('selectAll');
    if (!sel) return;
    document.querySelectorAll('.post-checkbox').forEach(cb => cb.checked = sel.checked);
    updateBulkDeleteButton();
}

function updateBulkDeleteButton() {
    const checked = document.querySelectorAll('.post-checkbox:checked');
    const all = document.querySelectorAll('.post-checkbox');
    const btn = document.getElementById('bulkDeleteBtn');
    const sel = document.getElementById('selectAll');
    if (btn) {
        btn.classList.toggle('hidden', checked.length === 0);
        btn.classList.toggle('inline-flex', checked.length > 0);
    }
    if (sel) {
        sel.checked = all.length > 0 && checked.length === all.length;
        sel.indeterminate = checked.length > 0 && checked.length < all.length;
    }
}

// ── Delete ──
let deleteTarget = null, deleteType = 'single';

function deleteSinglePost(id) {
    deleteTarget = id; deleteType = 'single';
    document.getElementById('modalTitle').textContent = 'Delete post?';
    document.getElementById('modalMessage').textContent = 'This will permanently remove the post and cannot be undone.';
    openDeleteModal();
}

function confirmBulkDelete() {
    const checked = document.querySelectorAll('.post-checkbox:checked');
    deleteTarget = Array.from(checked).map(cb => cb.value);
    deleteType = 'bulk';
    document.getElementById('modalTitle').textContent = `Delete ${deleteTarget.length} post${deleteTarget.length !== 1 ? 's' : ''}?`;
    document.getElementById('modalMessage').textContent = 'This will permanently remove the selected posts and cannot be undone.';
    openDeleteModal();
}

function openDeleteModal() {
    document.getElementById('deleteModal').classList.remove('hidden');
}
function closeDeleteModal() {
    document.getElementById('deleteModal').classList.add('hidden');
    deleteTarget = null; deleteType = 'single';
}
document.getElementById('deleteModal').addEventListener('click', function(e) {
    if (e.target === this) closeDeleteModal();
});
document.getElementById('confirmDeleteBtn').addEventListener('click', async function() {
    const ids = deleteType === 'single' ? [parseInt(deleteTarget)] : deleteTarget.map(Number);
    this.disabled = true; this.textContent = 'Deleting…';
    try {
        const r = await fetch('/api/admin/posts', { method: 'DELETE', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ids}) });
        const res = await r.json();
        if (res.deleted > 0) { window.location.reload(); return; }
        if (res.errors?.length) { alert('Delete failed: ' + res.errors.join(', ')); }
        closeDeleteModal();
    } catch(e) { alert('Error: ' + e.message); closeDeleteModal(); }
    finally { this.disabled = false; this.textContent = 'Delete'; }
});

// ── Version History ──
function openVersionHistory(btn) {
    const postId = btn.dataset.postId;
    const title = btn.dataset.postTitle;
    document.getElementById('versionModalSubtitle').textContent = title;
    const modal = document.getElementById('versionModal');
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
    loadVersions(postId);
}
function closeVersionModal() {
    document.getElementById('versionModal').classList.remove('open');
    document.body.style.overflow = '';
}

async function loadVersions(postId) {
    const list = document.getElementById('versionList');
    list.innerHTML = `<div class="flex items-center justify-center py-8"><svg class="animate-spin h-5 w-5" style="color:var(--accent);" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg></div>`;
    try {
        const r = await fetch(`/api/posts/${postId}/versions`);
        if (!r.ok) throw new Error('Server error');
        const versions = await r.json();
        if (!versions || versions.length === 0) {
            list.innerHTML = `<div class="py-8 text-center text-sm" style="color:var(--text-tertiary);">No versions recorded yet.</div>`;
            return;
        }
        list.innerHTML = versions.map((v, i) => `
            <div class="flex items-start gap-3 p-3 rounded-lg transition-colors" style="background:${i === 0 ? 'rgba(13,148,136,0.08)' : 'transparent'};border:1px solid ${i === 0 ? 'rgba(13,148,136,0.2)' : 'var(--border-light)'};" data-version-row="${v.VersionNumber}">
                <div class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold" style="${i === 0 ? 'background:var(--btn-primary-bg);color:var(--btn-primary-text);' : 'background:var(--bg-tertiary);color:var(--text-secondary);'}">
                    v${v.VersionNumber}
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-sm font-medium truncate" style="color:var(--text-primary);">${escHtml(v.Title)}</span>
                        ${i === 0 ? '<span class="shrink-0 admin-badge admin-badge-accent">Latest</span>' : ''}
                    </div>
                    <div class="flex items-center gap-2 mt-0.5">
                        <span class="text-xs font-medium" style="color:var(--accent);">${escHtml(v.CreatedByName)}</span>
                        <span class="text-xs" style="color:var(--text-tertiary);">·</span>
                        <span class="text-xs" style="color:var(--text-tertiary);">${fmtDate(v.CreatedAt)}</span>
                    </div>
                </div>
                ${isAdmin ? `<button type="button" class="admin-icon-btn danger shrink-0" title="Delete version" onclick="deleteVersion(${postId}, ${v.VersionNumber}, this)"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button>` : ''}
            </div>
        `).join('');
    } catch(e) {
        list.innerHTML = `<div class="py-8 text-center text-sm text-red-500">Failed to load versions.</div>`;
    }
}

function fmtDate(iso) {
    if (!iso) return '';
    const d = new Date(iso);
    return d.toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'})
        + ' at ' + d.toLocaleTimeString('en-US', {hour:'2-digit', minute:'2-digit'});
}

function escHtml(s) {
    return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

async function deleteVersion(postId, versionNum, btn) {
    if (!confirm(`Delete version v${versionNum}?`)) return;
    btn.disabled = true;
    try {
        const r = await fetch(`/api/posts/${postId}/versions/${versionNum}`, { method: 'DELETE' });
        if (!r.ok) { const t = await r.text(); alert('Delete failed: ' + t); return; }
        const row = btn.closest('[data-version-row]');
        if (row) row.remove();
        const list = document.getElementById('versionList');
        if (!list.querySelector('[data-version-row]')) {
            list.innerHTML = `<div class="py-8 text-center text-sm" style="color:var(--text-tertiary);">No versions recorded yet.</div>`;
        }
    } catch(e) { alert('Error: ' + e.message); }
    finally { btn.disabled = false; }
}

// ── Column visibility ──
const COL_STORAGE_KEY = 'adminPostsCols';
const COL_DEFAULTS = { authors: true, categories: true, status: true, created: true, slug: true };

function getColPrefs() {
    try { return Object.assign({}, COL_DEFAULTS, JSON.parse(localStorage.getItem(COL_STORAGE_KEY) || '{}')); }
    catch(e) { return Object.assign({}, COL_DEFAULTS); }
}

function applyColVisibility(prefs) {
    Object.keys(prefs).forEach(col => {
        const show = prefs[col];
        document.querySelectorAll(`[data-col-th="${col}"]`).forEach(el => el.style.display = show ? '' : 'none');
        document.querySelectorAll(`[data-col-td="${col}"]`).forEach(el => el.style.display = show ? '' : 'none');
        const cb = document.querySelector(`.col-toggle[data-col="${col}"]`);
        if (cb) cb.checked = show;
    });
}

function toggleColPicker() {
    document.getElementById('colPickerMenu').classList.toggle('hidden');
}

document.addEventListener('click', function(e) {
    const wrapper = document.getElementById('colPickerWrapper');
    if (wrapper && !wrapper.contains(e.target)) {
        document.getElementById('colPickerMenu').classList.add('hidden');
    }
});

document.querySelectorAll('.col-toggle').forEach(cb => {
    cb.addEventListener('change', function() {
        const prefs = getColPrefs();
        prefs[this.dataset.col] = this.checked;
        localStorage.setItem(COL_STORAGE_KEY, JSON.stringify(prefs));
        applyColVisibility(prefs);
    });
});

document.addEventListener('DOMContentLoaded', function() {
    updateBulkDeleteButton();
    applyColVisibility(getColPrefs());
});
</script>

{{template "modern-footer" .}}
