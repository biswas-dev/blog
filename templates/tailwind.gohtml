{{define "modern-header"}}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {{block "meta-description" .}}<meta name="description" content="Anshuman Biswas - Software Engineering & Cloud Architecture Blog" />{{end}}
    {{block "meta-robots" .}}<meta name="robots" content="index, follow" />{{end}}
    {{block "head-extra" .}}{{end}}
    <meta name="author" content="Anshuman Biswas" />

    <!-- Open Graph / Social sharing -->
    {{block "og-meta" .}}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Anshuman Biswas" />
    <meta property="og:title" content="Anshuman Biswas - Engineering Insights" />
    <meta property="og:description" content="Software Engineering & Cloud Architecture Blog" />
    {{end}}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/static/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" sizes="180x180" href="/static/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/static/favicon.svg" />

    <!-- Canonical URL -->
    {{block "canonical" .}}<link rel="canonical" href="https://anshumanbiswas.com/" />{{end}}

    <!-- Resource hints (only for third-party origins actually used) -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="alternate" type="application/rss+xml" title="Anshuman Biswas - Engineering Insights" href="/rss">

    <!-- Styles — minified, served with 1-year immutable cache -->
    <link rel="stylesheet" href="/static/css/theme.min.css?v=2026-11-21b" />

    <!-- Dark mode script — runs before paint to prevent flash -->
    <script>
        const savedTheme = localStorage.getItem('theme') ||
                          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
        }
        localStorage.setItem('godraw-dark', savedTheme === 'dark' ? 'true' : 'false');
    </script>

    <title>{{block "page-title" .}}Blog - Anshuman Biswas{{end}}</title>

    <!-- Google Analytics and Datadog RUM load once the page has loaded and the browser is idle,
         so their ~250 KB of script never competes with the first render. -->
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-4HZL5ZZ0BC');
        window.DD_RUM = {q:[],onReady:function(c){this.q.push(c)}};
        addEventListener('load', function() {
            (window.requestIdleCallback || setTimeout)(function() {
                ['https://www.googletagmanager.com/gtag/js?id=G-4HZL5ZZ0BC',
                 'https://www.datadoghq-browser-agent.com/us1/v6/datadog-rum.js'].forEach(function(src) {
                    var s = document.createElement('script'); s.async = true; s.src = src; document.head.appendChild(s);
                });
            });
        });
        window.DD_RUM.onReady(function() {
            window.DD_RUM.init({
                clientToken: 'pubfbcbf0288df99fa7a982bfc422df9ae7',
                applicationId: '88d1ea7c-beae-4a1a-9b81-1195af940658',
                site: 'datadoghq.com',
                service: 'blog',
                env: '{{block "dd-env" .}}production{{end}}',
                version: '{{block "dd-version" .}}{{end}}',
                sessionSampleRate: 100,
                sessionReplaySampleRate: 20,
                trackUserInteractions: true,
                trackResources: true,
                trackLongTasks: true,
                defaultPrivacyLevel: 'mask-user-input',
            });
        });
    </script>
</head>
<body data-draw-hover-delay="{{siteConfig "draw_hover_delay" "3"}}">
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">

            <a href="/" class="logo-container">
                <span class="logo-text">
                    Anshuman <span class="highlight">B</span>iswas
                </span>
            </a>

            <!-- Desktop Navigation -->
            <ul class="nav-links">
                <li><a href="/" class="nav-link {{if eq .CurrentPage "home"}}active{{end}}">Home</a></li>
                <li><a href="/slides" class="nav-link {{if eq .CurrentPage "slides"}}active{{end}}">Slides</a></li>
                <li><a href="/guides" class="nav-link {{if eq .CurrentPage "guides"}}active{{end}}">Guides</a></li>
                <li><a href="/books" class="nav-link {{if eq .CurrentPage "books"}}active{{end}}">Books</a></li>
                <li><a href="/papers" class="nav-link {{if eq .CurrentPage "papers"}}active{{end}}">Papers</a></li>
                <li><a href="/about" class="nav-link {{if eq .CurrentPage "about"}}active{{end}}">About</a></li>
                {{if .LoggedIn}}
                    {{if .UserPermissions.CanViewAdmin}}
                        <li class="relative admin-dropdown">
                            <button class="nav-link admin-dropdown-btn {{if eq .CurrentPage "admin"}}active{{end}}" aria-label="Admin menu">
                                <span>{{if .IsAdmin}}Admin{{else}}Editor{{end}}</span>
                                {{icon "chevron-down" "w-4 h-4"}}
                            </button>
                            <div class="admin-dropdown-menu">
                                <div>
                                    <a href="/admin/posts" class="dropdown-item">
                                        <span class="flex items-center gap-2">
                                            {{icon "document" "w-4 h-4"}}
                                            <span>Posts</span>
                                        </span>
                                    </a>
                                    <a href="/admin/posts/new" class="dropdown-item">
                                        <span class="flex items-center gap-2">
                                            {{icon "plus" "w-4 h-4"}}
                                            <span>New Post</span>
                                        </span>
                                    </a>
                                </div>
                                <div class="h-px bg-gray-200 dark:bg-gray-700 my-2"></div>
                                <div>
                                    <a href="/admin/slides" class="dropdown-item">
                                        <span class="flex items-center gap-2">
                                            {{icon "columns" "w-4 h-4"}}
                                            <span>Slides</span>
                                        </span>
                                    </a>
                                    <a href="/admin/slides#new-deck-title" class="dropdown-item">
                                        <span class="flex items-center gap-2">
                                            {{icon "plus" "w-4 h-4"}}
                                            <span>New Slide</span>
                                        </span>
                                    </a>
                                </div>
                                <div class="h-px bg-gray-200 dark:bg-gray-700 my-2"></div>
                                <div>
                                    <a href="/admin/guides" class="dropdown-item">
                                        <span class="flex items-center gap-2">
                                            {{icon "document" "w-4 h-4"}}
                                            <span>Guides</span>
                                        </span>
                                    </a>
                                    <a href="/admin/guides/new" class="dropdown-item">
                                        <span class="flex items-center gap-2">
                                            {{icon "plus" "w-4 h-4"}}
                                            <span>New Guide</span>
                                        </span>
                                    </a>
                                </div>
                                {{if .IsAdmin}}
                                <div class="h-px bg-gray-200 dark:bg-gray-700 my-2"></div>
                                <div>
                                    <a href="/admin/books" class="dropdown-item">
                                        <span class="flex items-center gap-2">
                                            {{icon "document" "w-4 h-4"}}
                                            <span>Books</span>
                                        </span>
                                    </a>
                                    <a href="/admin/books/new" class="dropdown-item">
                                        <span class="flex items-center gap-2">
                                            {{icon "plus" "w-4 h-4"}}
                                            <span>New Book</span>
                                        </span>
                                    </a>
                                </div>
                                {{end}}
                                <div class="h-px bg-gray-200 dark:bg-gray-700 my-2"></div>
                                <div>
                                    <a href="/admin/papers" class="dropdown-item">
                                        <span class="flex items-center gap-2">
                                            {{icon "file-text" "w-4 h-4"}}
                                            <span>Papers</span>
                                        </span>
                                    </a>
                                    <a href="/admin/papers/new" class="dropdown-item">
                                        <span class="flex items-center gap-2">
                                            {{icon "plus" "w-4 h-4"}}
                                            <span>New Paper</span>
                                        </span>
                                    </a>
                                </div>
                                <div class="h-px bg-gray-200 dark:bg-gray-700 my-2"></div>
                                <div>
                                    <a href="/admin/categories" class="dropdown-item">
                                        <span class="flex items-center gap-2">
                                            {{icon "list" "w-4 h-4"}}
                                            <span>Categories</span>
                                        </span>
                                    </a>
                                    <a href="/admin/formatting-guide" class="dropdown-item">
                                        <span class="flex items-center gap-2">
                                            {{icon "file-text" "w-4 h-4"}}
                                            <span>Formatting Guide</span>
                                        </span>
                                    </a>
                                    {{if .IsAdmin}}
                                    <a href="/admin/system" class="dropdown-item">
                                        <span class="flex items-center gap-2">
                                            {{icon "settings" "w-4 h-4"}}
                                            <span>System</span>
                                        </span>
                                    </a>
                                    {{end}}
                                    <a href="/admin/analytics" class="dropdown-item">
                                        <span class="flex items-center gap-2">
                                            {{icon "bar-chart" "w-4 h-4"}}
                                            <span>Analytics</span>
                                        </span>
                                    </a>
                                    {{if .IsAdmin}}
                                    <a href="/admin/users" class="dropdown-item">
                                        <span class="flex items-center gap-2">
                                            {{icon "users" "w-4 h-4"}}
                                            <span>Users</span>
                                        </span>
                                    </a>
                                    {{end}}
                                </div>
                            </div>
                        </li>
                    {{end}}
                    <li class="relative user-dropdown">
                        <button class="nav-link user-dropdown-btn" aria-label="User menu">
                            <span class="avatar-circle">{{initial .Username}}</span>
                            <span class="username-text">{{.Username}}</span>
                            {{icon "chevron-down" "w-4 h-4"}}
                        </button>
                        <div class="user-dropdown-menu">
                            <div>
                                <a href="/users/me" class="dropdown-item">
                                    <span class="flex items-center gap-2">
                                        {{icon "user" "w-4 h-4"}}
                                        <span>Profile</span>
                                    </span>
                                </a>
                                <a href="/my-posts" class="dropdown-item">
                                    <span class="flex items-center gap-2">
                                        {{icon "archive" "w-4 h-4"}}
                                        <span>My Activity</span>
                                    </span>
                                </a>
                                <a href="/api-access" class="dropdown-item">
                                    <span class="flex items-center gap-2">
                                        {{icon "api" "w-4 h-4"}}
                                        <span>API Access</span>
                                    </span>
                                </a>
                            </div>
                            <div class="h-px bg-gray-200 dark:bg-gray-700 my-2"></div>
                            <div>
                                <a href="/docs/formatting-guide" class="dropdown-item">
                                    <span class="flex items-center gap-2">
                                        {{icon "file-text" "w-4 h-4"}}
                                        <span>Formatting Guide</span>
                                    </span>
                                </a>
                                <a href="/admin/categories" class="dropdown-item">
                                    <span class="flex items-center gap-2">
                                        {{icon "list" "w-4 h-4"}}
                                        <span>Categories</span>
                                    </span>
                                </a>
                            </div>
                        </div>
                    </li>
                {{else}}
                    <li><a href="/signin" class="nav-link ">Sign In</a></li>
                    {{if not .SignupDisabled}}
                        <li><a href="/signup" class="nav-link ">Sign Up</a></li>
                    {{end}}
                {{end}}

                <!-- Theme Toggle -->
                <li>
                    <button id="theme-toggle" class="nav-link" aria-label="Toggle theme">
                        {{icon "sun" "w-5 h-5 hidden dark:block"}}
                        {{icon "moon" "w-5 h-5 block dark:hidden"}}
                    </button>
                </li>
                <!-- Sign Out / Sign In icon (conditional) -->
                {{if .LoggedIn}}
                <li>
                    <a id="signout-link" href="/logout" class="nav-link" aria-label="Sign out" title="Sign out">
                        {{icon "logout" "w-5 h-5"}}
                    </a>
                </li>
                {{end}}

                <!-- Search -->
                <li>
                    <button id="search-toggle" class="nav-link" aria-label="Search" style="display:inline-flex;align-items:center;">
                        {{icon "search" "w-5 h-5"}}
                        <kbd class="search-kbd">&#8984;K</kbd>
                    </button>
                </li>
            </ul>

            <!-- Mobile Menu Button -->
            <button class="mobile-menu-button" id="mobile-menu-btn" aria-label="Toggle menu">
                {{icon "menu" "w-6 h-6"}}
            </button>

            <!-- Mobile Menu -->
            <div class="mobile-menu" id="mobile-menu">
                <ul class="mobile-nav-links">
                    <li><a href="/slides" class="nav-link {{if eq .CurrentPage "slides"}}active{{end}}">Slides</a></li>
                    <li><a href="/guides" class="nav-link {{if eq .CurrentPage "guides"}}active{{end}}">Guides</a></li>
                    <li><a href="/books" class="nav-link {{if eq .CurrentPage "books"}}active{{end}}">Books</a></li>
                    <li><a href="/papers" class="nav-link {{if eq .CurrentPage "papers"}}active{{end}}">Papers</a></li>
                    <li><a href="/about" class="nav-link {{if eq .CurrentPage "about"}}active{{end}}">About</a></li>
                    {{if .LoggedIn}}
                        <li><a href="/my-posts" class="nav-link {{if eq .CurrentPage "my-posts"}}active{{end}}">My Activity</a></li>
                        <li><a href="/users/me" class="nav-link {{if eq .CurrentPage "profile"}}active{{end}}">Profile ({{.Username}})</a></li>
                        {{if .UserPermissions.CanViewAdmin}}
                            <li><a href="/admin/posts" class="nav-link {{if eq .CurrentPage "admin"}}active{{end}}">Posts</a></li>
                            <li><a href="/admin/posts/new" class="nav-link">New Post</a></li>
                            <li><a href="/admin/slides" class="nav-link">Slides</a></li>
                            <li><a href="/admin/slides#new-deck-title" class="nav-link">New Slide</a></li>
                            <li><a href="/admin/guides" class="nav-link">Guides</a></li>
                            <li><a href="/admin/guides/new" class="nav-link">New Guide</a></li>
                            {{if .IsAdmin}}
                            <li><a href="/admin/books" class="nav-link">Books</a></li>
                            <li><a href="/admin/books/new" class="nav-link">New Book</a></li>
                            {{end}}
                            <li><a href="/admin/papers" class="nav-link">Papers</a></li>
                            <li><a href="/admin/papers/new" class="nav-link">New Paper</a></li>
                            <li><a href="/admin/categories" class="nav-link">Categories</a></li>
                            <li><a href="/admin/formatting-guide" class="nav-link">Formatting Guide</a></li>
                            <li><a href="/admin/analytics" class="nav-link">Analytics</a></li>
                            {{if .IsAdmin}}
                            <li><a href="/admin/system" class="nav-link">System</a></li>
                            <li><a href="/admin/users" class="nav-link">Users</a></li>
                            {{end}}
                        {{end}}
                        <li><a href="/logout" class="nav-link">Sign Out</a></li>
                    {{else}}
                        <li><a href="/signin" class="nav-link ">Sign In</a></li>
                        {{if not .SignupDisabled}}
                            <li><a href="/signup" class="nav-link ">Sign Up</a></li>
                        {{end}}
                    {{end}}
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="main-container">
{{end}}

{{define "modern-footer"}}
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-links">
                <a href="https://biswas.me" class="footer-link">Website</a>
                <a href="mailto:anshuman@biswas.me" class="footer-link">Contact</a>
                <a href="https://github.com/anchoo2kewl" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a>
                <a href="https://linkedin.com/in/anshuman-biswas-phd-613b0145" target="_blank" rel="noopener noreferrer" class="footer-link">LinkedIn</a>
                <a href="/rss" class="footer-link">RSS</a>
            </div>
            <p class="footer-text">
                &copy; <span id="current-year"></span> Anshuman Biswas
            </p>
        </div>
    </footer>

    <!-- Scripts -->

    <!-- Reader engagement tracker (time on page, scroll depth, section attention) -->
    <script src="/static/js/engagement.js?v=2026-04-04c" defer></script>

    <!-- go-draw embed scroll guard: block pointer events on diagram iframes
         until the reader has hovered for 5 seconds, so normal page scrolling
         isn't hijacked when the cursor passes over an embedded drawing. -->
    <style>.godraw-embed iframe { pointer-events: none; transition: opacity 0.2s; }
           .godraw-embed.draw-active iframe { pointer-events: auto; }
           .godraw-embed .draw-hover-hint { position:absolute; top:8px; left:50%; transform:translateX(-50%);
             padding:6px 14px; border-radius:999px; font-size:12px; color:#fff; background:rgba(0,0,0,0.6);
             backdrop-filter:blur(4px); pointer-events:none; opacity:0; transition:opacity 0.15s; z-index:3;
             display:flex; align-items:center; gap:8px; font-weight:500; white-space:nowrap; }
           .godraw-embed:hover .draw-hover-hint { opacity:1; }
           .godraw-embed.draw-active .draw-hover-hint { opacity:0; }
           .godraw-embed .draw-hover-ring { width:14px; height:14px; position:relative; }
           .godraw-embed .draw-hover-ring svg { width:100%; height:100%; transform:rotate(-90deg); }
           .godraw-embed .draw-hover-ring circle { fill:none; stroke-width:2; stroke-linecap:round; }
           .godraw-embed .draw-hover-ring .draw-ring-bg { stroke:rgba(255,255,255,0.25); }
           .godraw-embed .draw-hover-ring .draw-ring-fg { stroke:#fff; transition:stroke-dashoffset 0.1s linear; }
           /* Touch: tap-to-activate shield sits on top of the iframe. */
           .godraw-embed .draw-tap-shield { position:absolute; inset:0; z-index:2; background:transparent;
             display:flex; align-items:flex-start; justify-content:center; padding-top:12px;
             cursor:pointer; -webkit-tap-highlight-color:transparent; }
           .godraw-embed.draw-active .draw-tap-shield { display:none; }
           .godraw-embed .draw-tap-shield .draw-tap-pill { padding:8px 16px; border-radius:999px; font-size:13px;
             color:#fff; background:rgba(0,0,0,0.7); backdrop-filter:blur(4px); font-weight:500;
             box-shadow:0 2px 8px rgba(0,0,0,0.3); pointer-events:none; white-space:nowrap; }
           .godraw-embed .draw-tap-close { position:absolute; top:8px; right:8px; width:34px; height:34px; z-index:4;
             border-radius:999px; background:rgba(0,0,0,0.7); color:#fff; border:none; cursor:pointer;
             display:none; align-items:center; justify-content:center; font-size:20px; line-height:1; padding:0;
             box-shadow:0 2px 8px rgba(0,0,0,0.3); -webkit-tap-highlight-color:transparent; }
           .godraw-embed.draw-active .draw-tap-close { display:flex; }</style>
    <script src="/static/js/site.js?v=2026-11-21"></script>

    <!-- Keyboard navigation (j/k for sections, / for search) -->
    <style>
      #keynav-search { display: none; position: fixed; inset: 0; z-index: 9999; }
      #keynav-search.active { display: block; }
      .keynav-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(2px); }
      .keynav-modal { position: absolute; top: 12%; left: 50%; transform: translateX(-50%); width: 92%; max-width: 640px;
        background: #fff; border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); overflow: hidden; }
      html.dark .keynav-modal { background: #1a1a1a; color: #e5e5e5; }
      .keynav-input-wrap { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-bottom: 1px solid #e5e7eb; }
      html.dark .keynav-input-wrap { border-color: #333; }
      .keynav-input-wrap svg { color: #9ca3af; flex-shrink: 0; }
      .keynav-modal input { flex: 1; border: none; background: transparent; font-size: 15px; color: inherit; outline: none; }
      .keynav-modal kbd { font-size: 11px; padding: 3px 6px; border: 1px solid #d1d5db; border-radius: 4px; background: #f9fafb; color: #6b7280; font-family: inherit; }
      html.dark .keynav-modal kbd { border-color: #404040; background: #262626; color: #9ca3af; }
      .keynav-results { max-height: 420px; overflow-y: auto; }
      .keynav-hint { padding: 28px; text-align: center; color: #9ca3af; font-size: 13px; }
      .keynav-result { display: flex; gap: 12px; align-items: flex-start; padding: 12px 18px; text-decoration: none; color: inherit;
        border-bottom: 1px solid #f3f4f6; cursor: pointer; }
      html.dark .keynav-result { border-color: #262626; }
      .keynav-result.selected { background: #eff6ff; }
      html.dark .keynav-result.selected { background: #1e3a5f; }
      .keynav-type { font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;
        padding: 3px 7px; border-radius: 4px; margin-top: 2px; flex-shrink: 0; }
      .keynav-type-post { background: #dbeafe; color: #1e40af; }
      .keynav-type-slide { background: #f3e8ff; color: #6b21a8; }
      .keynav-type-guide { background: #dcfce7; color: #166534; }
      html.dark .keynav-type-post { background: #1e3a5f; color: #93c5fd; }
      html.dark .keynav-type-slide { background: #3b1360; color: #d8b4fe; }
      html.dark .keynav-type-guide { background: #14532d; color: #86efac; }
      .keynav-meta { flex: 1; min-width: 0; }
      .keynav-title { font-weight: 600; font-size: 14px; line-height: 1.3; }
      .keynav-excerpt { font-size: 12px; color: #6b7280; margin-top: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      html.dark .keynav-excerpt { color: #9ca3af; }
      .keynav-footer { display: flex; gap: 18px; padding: 10px 18px; border-top: 1px solid #f3f4f6; font-size: 11px; color: #9ca3af; }
      html.dark .keynav-footer { border-color: #262626; }
      .keynav-footer span { display: flex; align-items: center; gap: 4px; }

      /* Find-in-page bar */
      #keynav-find { display: none; position: fixed; top: 16px; right: 16px; z-index: 9998; }
      #keynav-find.active { display: block; }
      .keynav-find-bar { display: flex; align-items: center; gap: 6px; background: #fff; padding: 8px 10px;
        border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.15); border: 1px solid #e5e7eb; }
      html.dark .keynav-find-bar { background: #1a1a1a; border-color: #333; color: #e5e5e5; }
      .keynav-find-bar svg { color: #9ca3af; flex-shrink: 0; }
      .keynav-find-bar input { border: none; background: transparent; color: inherit; outline: none;
        font-size: 13px; width: 180px; padding: 2px 4px; }
      .keynav-find-counter { font-size: 11px; color: #6b7280; min-width: 50px; text-align: right; }
      html.dark .keynav-find-counter { color: #9ca3af; }
      .keynav-find-bar button { background: transparent; border: none; color: #6b7280; cursor: pointer;
        padding: 3px 6px; font-size: 12px; border-radius: 3px; }
      .keynav-find-bar button:hover { background: #f3f4f6; color: #111; }
      html.dark .keynav-find-bar button { color: #9ca3af; }
      html.dark .keynav-find-bar button:hover { background: #262626; color: #e5e5e5; }
      mark.keynav-match { background: #fef08a; color: inherit; border-radius: 2px; padding: 0 1px; }
      mark.keynav-match.active { background: #f59e0b; color: #fff; }
      html.dark mark.keynav-match { background: #854d0e; color: #fef3c7; }
      html.dark mark.keynav-match.active { background: #f59e0b; color: #1a1a1a; }
    </style>
    <script src="/static/js/keynav.js?v=2026-04-04b" defer></script>
</body>
</html>
{{end}}
