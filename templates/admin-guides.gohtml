{{define "meta-robots"}}<meta name="robots" content="noindex, nofollow" />{{end}}
{{template "modern-header" .}}

<div class="admin-page">
    <!-- Header -->
    <div class="admin-header">
        <div class="admin-header-text">
            <h1>Guide Management</h1>
            <p>Create and manage long-form guides and tutorials</p>
        </div>
        <div class="admin-header-actions">
            <a href="/guides" class="admin-btn-secondary">
                {{icon "external-link" "w-4 h-4"}}
                View Public Guides
            </a>
            <a href="/admin/guides/new" class="admin-btn-primary">
                {{icon "plus" "w-4 h-4"}}
                New Guide
            </a>
        </div>
    </div>

    <!-- Guides Table -->
    <div class="admin-card">
        {{if .Guides.Guides}}
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th scope="col">Title</th>
                        <th scope="col">Author</th>
                        <th scope="col">Status</th>
                        <th scope="col">Categories</th>
                        <th scope="col">Created</th>
                        <th scope="col" class="is-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .Guides.Guides}}
                    <tr>
                        <td class="admin-title-cell">
                            <a href="/guides/{{.Slug}}" class="admin-title-link">{{.Title}}</a>
                            <div class="admin-subtext">/guides/{{.Slug}}</div>
                        </td>
                        <td class="admin-secondary-cell">
                            <div class="admin-cell-row">
                                {{if .AuthorAvatarURL}}
                                <img src="{{thumbURL .AuthorAvatarURL}}" alt="{{.AuthorDisplayName}}" class="w-6 h-6 rounded-full object-cover" width="24" height="24">
                                {{end}}
                                <span>{{.AuthorDisplayName}}</span>
                            </div>
                        </td>
                        <td>
                            {{if .IsPublished}}
                            <span class="admin-badge admin-badge-published">
                                <span class="admin-badge-dot"></span>
                                Published
                            </span>
                            {{else}}
                            <span class="admin-badge admin-badge-draft">
                                <span class="admin-badge-dot"></span>
                                Draft
                            </span>
                            {{end}}
                        </td>
                        <td>
                            <div class="admin-badge-list">
                                {{range .Categories}}
                                <span class="admin-badge admin-badge-accent">{{.Name}}</span>
                                {{end}}
                                {{if not .Categories}}<span class="admin-muted">&mdash;</span>{{end}}
                            </div>
                        </td>
                        <td class="admin-num">
                            {{.PublicationDate}}
                        </td>
                        <td class="is-right">
                            <div class="admin-actions">
                                <a href="/guides/{{.Slug}}" target="_blank" class="admin-icon-btn" title="View guide" aria-label="View {{.Title}}">
                                    {{icon "eye" "w-4 h-4"}}
                                </a>
                                <a href="/admin/guides/{{.ID}}/edit" class="admin-link-action">Edit</a>
                                <form method="POST" action="/admin/guides/{{.ID}}/delete" onsubmit="return confirm('Delete this guide?');" style="display:inline;">
                                    <button type="submit" class="admin-link-action danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="admin-empty">
            <div class="admin-empty-icon">{{icon "document" "w-10 h-10"}}</div>
            <h3>No guides yet</h3>
            <p>Create your first long-form guide or tutorial.</p>
            <a href="/admin/guides/new" class="admin-btn-primary">
                {{icon "plus" "w-4 h-4"}}
                New Guide
            </a>
        </div>
        {{end}}
    </div>
</div>

{{template "modern-footer" .}}
