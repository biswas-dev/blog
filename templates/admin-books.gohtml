{{define "meta-robots"}}<meta name="robots" content="noindex, nofollow" />{{end}}
{{template "modern-header" .}}

<div class="admin-page">
    <!-- Header -->
    <div class="admin-header">
        <div class="admin-header-text">
            <h1>Books</h1>
            <p>Track and manage your reading list, ratings, and reviews</p>
        </div>
        <div class="admin-header-actions">
            <a href="/books" class="admin-btn-secondary">
                {{icon "external-link" "w-4 h-4"}}
                View Public Books
            </a>
            <a href="/admin/books/new" class="admin-btn-primary">
                {{icon "plus" "w-4 h-4"}}
                New Book
            </a>
        </div>
    </div>

    <!-- Status Filter Tabs -->
    <div class="admin-tabs">
        <a href="/admin/books" class="admin-tab {{if eq .StatusFilter ""}}active{{end}}">All</a>
        <a href="/admin/books?status=reading" class="admin-tab {{if eq .StatusFilter "reading"}}active{{end}}">Reading</a>
        <a href="/admin/books?status=completed" class="admin-tab {{if eq .StatusFilter "completed"}}active{{end}}">Completed</a>
        <a href="/admin/books?status=want-to-read" class="admin-tab {{if eq .StatusFilter "want-to-read"}}active{{end}}">Want to Read</a>
        <a href="/admin/books?status=abandoned" class="admin-tab {{if eq .StatusFilter "abandoned"}}active{{end}}">Abandoned</a>
    </div>

    <!-- Books Table -->
    <div class="admin-card">
        {{if .Books}}
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th scope="col">Cover</th>
                        <th scope="col">Title</th>
                        <th scope="col">Author</th>
                        <th scope="col">Reading Status</th>
                        <th scope="col">Rating</th>
                        <th scope="col">Date Read</th>
                        <th scope="col">Visibility</th>
                        <th scope="col" class="is-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .Books}}
                    <tr>
                        <td>
                            {{if .CoverImageURL}}
                            <img src="{{.CoverImageURL}}" alt="{{.Title}}" class="admin-thumb" width="38" height="54" />
                            {{else}}
                            <div class="admin-thumb-placeholder">
                                {{icon "book-open" "w-4 h-4"}}
                            </div>
                            {{end}}
                        </td>
                        <td class="admin-title-cell">
                            <a href="/admin/books/{{.ID}}/edit" class="admin-title-link">{{.Title}}</a>
                            {{if .Slug}}<div class="admin-subtext">/books/{{.Slug}}</div>{{end}}
                        </td>
                        <td class="admin-secondary-cell">
                            {{if .BookAuthor}}{{.BookAuthor}}{{else}}<span class="admin-muted">&mdash;</span>{{end}}
                        </td>
                        <td>
                            {{if eq .ReadingStatus "reading"}}
                            <span class="admin-badge admin-badge-reading">Reading</span>
                            {{else if eq .ReadingStatus "completed"}}
                            <span class="admin-badge admin-badge-published">Completed</span>
                            {{else if eq .ReadingStatus "want-to-read"}}
                            <span class="admin-badge admin-badge-draft">Want to Read</span>
                            {{else if eq .ReadingStatus "abandoned"}}
                            <span class="admin-badge admin-badge-muted">Abandoned</span>
                            {{else}}
                            <span class="admin-badge admin-badge-muted">{{.ReadingStatus}}</span>
                            {{end}}
                        </td>
                        <td>
                            {{if .Rating}}
                                <span class="admin-star-rating">{{ratingStars .Rating}}</span>
                            {{else}}
                                <span class="admin-muted">&mdash;</span>
                            {{end}}
                        </td>
                        <td class="admin-num">
                            {{if .DateFinished}}{{.DateFinished}}{{else}}<span class="admin-muted">&mdash;</span>{{end}}
                        </td>
                        <td>
                            {{if .IsPublished}}
                            <span class="admin-badge admin-badge-published">
                                <span class="admin-badge-dot"></span>
                                Published
                            </span>
                            {{else}}
                            <span class="admin-badge admin-badge-draft">
                                <span class="admin-badge-dot"></span>
                                Draft
                            </span>
                            {{end}}
                        </td>
                        <td class="is-right">
                            <div class="admin-actions">
                                {{if .Slug}}
                                <a href="/books/{{.Slug}}" target="_blank" class="admin-icon-btn" title="View book" aria-label="View {{.Title}}">
                                    {{icon "eye" "w-4 h-4"}}
                                </a>
                                {{end}}
                                <a href="/admin/books/{{.ID}}/edit" class="admin-link-action">Edit</a>
                            </div>
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="admin-empty">
            <div class="admin-empty-icon">{{icon "book-open" "w-10 h-10"}}</div>
            <h3>No books yet</h3>
            <p>Start tracking your reading list and book reviews.</p>
            <a href="/admin/books/new" class="admin-btn-primary">
                {{icon "plus" "w-4 h-4"}}
                New Book
            </a>
        </div>
        {{end}}
    </div>
</div>

{{template "modern-footer" .}}
