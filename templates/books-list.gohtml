{{define "page-title"}}Books | Anshuman Biswas{{end}}
{{define "canonical"}}<link rel="canonical" href="https://anshumanbiswas.com/books" />{{end}}
{{define "meta-description"}}<meta name="description" content="Books I'm reading and have read — reviews, summaries, and notes by Anshuman Biswas." />{{end}}
{{template "modern-header" .}}

<style>
    .books-page { max-width: 1120px; margin: 0 auto; padding-bottom: 3rem; }
    .books-section { margin-top: 3rem; }
    .books-section { scroll-margin-top: 5rem; }
    .books-section-title { font-size: 1.5rem; font-weight: 700; color: var(--text-primary); margin: 0 0 1.5rem; display: flex; align-items: center; gap: 0.625rem; letter-spacing: -0.02em; }
    .books-section-title::before { content: ""; width: 4px; height: 1.25em; border-radius: 2px; background: linear-gradient(180deg, var(--accent), #6366f1); }
    .section-count { font-size: 0.8125rem; font-weight: 600; color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); padding: 0.125rem 0.5rem; border-radius: 999px; font-variant-numeric: tabular-nums; }
    .books-stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin-top: 1.25rem; }
    .books-stat { font-size: 0.875rem; color: var(--text-secondary); padding: 0.375rem 0.875rem; border: 1px solid var(--border-light); border-radius: 999px; background: var(--surface); transition: border-color 0.15s, color 0.15s; }
    .books-stat strong { color: var(--text-primary); font-variant-numeric: tabular-nums; }
    .books-stat:hover { border-color: var(--accent); color: var(--accent); }

    /* One shelf per status; covers lead, text sits underneath */
    .shelf { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 2rem 1.5rem; }
    .shelf-want, .shelf-abandoned { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); }
    .book-tile { position: relative; display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
    .book-tile-cover { display: block; aspect-ratio: 2/3; border-radius: 3px 6px 6px 3px; overflow: hidden; background: var(--bg-tertiary); margin-bottom: 0.5rem;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.08), 0 6px 16px -6px rgb(0 0 0 / 0.25); transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .book-tile-cover img { width: 100%; height: 100%; object-fit: cover; }
    .book-tile:hover .book-tile-cover { transform: translateY(-3px); box-shadow: 0 2px 4px rgb(0 0 0 / 0.08), 0 14px 28px -10px rgb(0 0 0 / 0.35); }
    .book-tile-title { font-size: 0.9375rem; font-weight: 600; line-height: 1.35; color: var(--text-primary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-wrap: balance; }
    .book-tile-title:hover { color: var(--accent); }
    .book-tile-author { font-size: 0.8125rem; color: var(--text-secondary); }
    .book-tile-author a:hover { color: var(--accent); }
    .book-tile-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.625rem; font-size: 0.75rem; color: var(--text-tertiary); font-variant-numeric: tabular-nums; margin-top: 0.125rem; }
    .book-tile-rating { color: #d97706; letter-spacing: 0.04em; }
    .book-tile-buy { color: var(--text-tertiary); text-decoration: underline; text-underline-offset: 2px; text-decoration-color: var(--border); }
    .book-tile-buy:hover { color: var(--accent); }
    .book-tile-edit { position: absolute; top: 0.5rem; right: 0.5rem; }
    .cover-placeholder { display: flex; align-items: center; justify-content: center; height: 100%; padding: 0.75rem; text-align: center; font-size: 0.8125rem; font-weight: 600; color: var(--text-secondary); }
    .empty-state { padding: 4rem 0; color: var(--text-secondary); }
    @media (max-width: 640px) {
        .shelf { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 1rem; }
        .shelf-want, .shelf-abandoned { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
</style>

<div class="books-page">
    <header class="page-header">
        {{if .FilterName}}
        <a href="/books" class="page-header-back">← All books</a>
        <h1>{{if eq .FilterType "author"}}Books by {{.FilterName}}{{else if eq .FilterType "publisher"}}Published by {{.FilterName}}{{else if eq .FilterType "genre"}}{{.FilterName}} Books{{else}}Books{{end}}</h1>
        {{else}}
        <h1>My <span class="hero-accent">Bookshelf</span></h1>
        <p>What I'm reading, what I've read, and what's next, with notes and reviews.</p>
        <div class="books-stats">
            {{if .CurrentlyReading}}<a href="#reading" class="books-stat"><strong>{{len .CurrentlyReading}}</strong> reading now</a>{{end}}
            {{if .Completed}}<a href="#read" class="books-stat"><strong>{{len .Completed}}</strong> read</a>{{end}}
            {{if .WantToRead}}<a href="#want" class="books-stat"><strong>{{len .WantToRead}}</strong> on the list</a>{{end}}
        </div>
        {{end}}
    </header>

    {{if and (not .CurrentlyReading) (not .Completed) (not .WantToRead) (not .Abandoned)}}
        <div class="empty-state">
            <h3>No books yet</h3>
            <p>Check back soon for book reviews and reading notes.</p>
        </div>
    {{else}}
        {{if .CurrentlyReading}}
        <section class="books-section" id="reading">
            <h2 class="books-section-title">Currently reading <span class="section-count">{{len .CurrentlyReading}}</span></h2>
            <div class="shelf shelf-reading">{{range .CurrentlyReading}}{{template "book-tile" (dict "Book" . "IsAdmin" $.IsAdmin "Section" "reading")}}{{end}}</div>
        </section>
        {{end}}
        {{if .Completed}}
        <section class="books-section" id="read">
            <h2 class="books-section-title">Read <span class="section-count">{{len .Completed}}</span></h2>
            <div class="shelf shelf-completed">{{range .Completed}}{{template "book-tile" (dict "Book" . "IsAdmin" $.IsAdmin "Section" "completed")}}{{end}}</div>
        </section>
        {{end}}
        {{if .WantToRead}}
        <section class="books-section" id="want">
            <h2 class="books-section-title">Want to read <span class="section-count">{{len .WantToRead}}</span></h2>
            <div class="shelf shelf-want">{{range .WantToRead}}{{template "book-tile" (dict "Book" . "IsAdmin" $.IsAdmin "Section" "want")}}{{end}}</div>
        </section>
        {{end}}
        {{if .Abandoned}}
        <section class="books-section" id="abandoned">
            <h2 class="books-section-title">Set aside <span class="section-count">{{len .Abandoned}}</span></h2>
            <div class="shelf shelf-abandoned">{{range .Abandoned}}{{template "book-tile" (dict "Book" . "IsAdmin" $.IsAdmin "Section" "abandoned")}}{{end}}</div>
        </section>
        {{end}}
    {{end}}
</div>

{{template "modern-footer" .}}

{{define "book-tile"}}
<article class="book-tile">
    <a href="/books/{{.Book.Slug}}" class="book-tile-cover" tabindex="-1" aria-hidden="true">
        {{if .Book.CoverImageURL}}<img src="{{.Book.CoverImageURL}}" alt="" width="200" height="300" loading="lazy" decoding="async">{{else}}<span class="cover-placeholder">{{.Book.Title}}</span>{{end}}
    </a>
    {{if .IsAdmin}}<a href="/admin/books/{{.Book.ID}}/edit" class="edit-icon book-tile-edit" aria-label="Edit {{.Book.Title}}" title="Edit">{{icon "edit" "w-4 h-4"}}</a>{{end}}
    <a href="/books/{{.Book.Slug}}" class="book-tile-title">{{.Book.Title}}</a>
    <span class="book-tile-author">{{authorLinks .Book.BookAuthor ""}}</span>
    {{if eq .Section "reading"}}{{if .Book.DateStarted}}<span class="book-tile-meta">Started {{.Book.DateStarted}}</span>{{end}}
    {{else if eq .Section "completed"}}<span class="book-tile-meta">{{if .Book.Rating}}<span class="book-tile-rating" aria-label="Rated {{.Book.Rating}} of 5">{{ratingStars .Book.Rating}}</span>{{end}}{{if .Book.DateFinished}}<span>{{.Book.DateFinished}}</span>{{end}}<a href="/books/{{.Book.Slug}}/buy" target="_blank" rel="noopener sponsored" class="book-tile-buy">Amazon</a></span>
    {{end}}
</article>
{{end}}
