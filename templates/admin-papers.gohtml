{{define "meta-robots"}}<meta name="robots" content="noindex, nofollow" />{{end}}
{{template "modern-header" .}}

<div class="admin-page">
    <!-- Header -->
    <div class="admin-header">
        <div class="admin-header-text">
            <h1>Papers</h1>
            <p>Manage your research paper collection, notes, and reviews</p>
        </div>
        <div class="admin-header-actions">
            <a href="/papers" class="admin-btn-secondary">
                {{icon "external-link" "w-4 h-4"}}
                View Public Papers
            </a>
            <a href="/admin/papers/new" class="admin-btn-primary">
                {{icon "plus" "w-4 h-4"}}
                New Paper
            </a>
        </div>
    </div>

    <!-- Stats -->
    <div class="admin-stats">
        <div class="admin-stat-card">
            <p class="admin-stat-label">Total Papers</p>
            <p class="admin-stat-value">{{len .Papers}}</p>
        </div>
        <div class="admin-stat-card">
            <p class="admin-stat-label">Published</p>
            <p class="admin-stat-value is-green">
                {{$pub := 0}}{{range .Papers}}{{if .IsPublished}}{{$pub = add $pub 1}}{{end}}{{end}}{{$pub}}
            </p>
        </div>
        <div class="admin-stat-card">
            <p class="admin-stat-label">Draft</p>
            <p class="admin-stat-value is-amber">
                {{$dft := 0}}{{range .Papers}}{{if not .IsPublished}}{{$dft = add $dft 1}}{{end}}{{end}}{{$dft}}
            </p>
        </div>
    </div>

    <!-- Papers Table -->
    <div class="admin-card">
        {{if .Papers}}
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th scope="col">Cover</th>
                        <th scope="col">Title</th>
                        <th scope="col">Authors</th>
                        <th scope="col">Conference</th>
                        <th scope="col">Year</th>
                        <th scope="col">Rating</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="is-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .Papers}}
                    <tr>
                        <td>
                            {{if .CoverImageURL}}
                            <img src="{{.CoverImageURL}}" alt="{{.Title}}" class="admin-thumb" width="38" height="54" />
                            {{else}}
                            <div class="admin-thumb-placeholder">
                                {{icon "document-text" "w-4 h-4"}}
                            </div>
                            {{end}}
                        </td>
                        <td class="admin-title-cell">
                            <a href="/admin/papers/{{.ID}}/edit" class="admin-title-link">{{.Title}}</a>
                            {{if .Slug}}<div class="admin-subtext">/papers/{{.Slug}}</div>{{end}}
                        </td>
                        <td class="admin-secondary-cell">
                            {{if .PaperAuthors}}{{.PaperAuthors}}{{else}}<span class="admin-muted">&mdash;</span>{{end}}
                        </td>
                        <td class="admin-secondary-cell">
                            {{if .Conference}}{{.Conference}}{{else}}<span class="admin-muted">&mdash;</span>{{end}}
                        </td>
                        <td class="admin-num">
                            {{if .PaperYear}}{{.PaperYear}}{{else}}<span class="admin-muted">&mdash;</span>{{end}}
                        </td>
                        <td>
                            {{if .Rating}}
                                <span class="admin-star-rating">{{ratingStars .Rating}}</span>
                            {{else}}
                                <span class="admin-muted">&mdash;</span>
                            {{end}}
                        </td>
                        <td>
                            {{if .IsPublished}}
                            <span class="admin-badge admin-badge-published">
                                <span class="admin-badge-dot"></span>
                                Published
                            </span>
                            {{else}}
                            <span class="admin-badge admin-badge-draft">
                                <span class="admin-badge-dot"></span>
                                Draft
                            </span>
                            {{end}}
                        </td>
                        <td class="is-right">
                            <div class="admin-actions">
                                {{if .Slug}}
                                <a href="/papers/{{.Slug}}" target="_blank" class="admin-icon-btn" title="View paper" aria-label="View {{.Title}}">
                                    {{icon "eye" "w-4 h-4"}}
                                </a>
                                {{end}}
                                <a href="/admin/papers/{{.ID}}/edit" class="admin-link-action">Edit</a>
                            </div>
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="admin-empty">
            <div class="admin-empty-icon">{{icon "document-text" "w-10 h-10"}}</div>
            <h3>No papers yet</h3>
            <p>Start building your research paper collection with reviews and annotations.</p>
            <a href="/admin/papers/new" class="admin-btn-primary">
                {{icon "plus" "w-4 h-4"}}
                New Paper
            </a>
        </div>
        {{end}}
    </div>
</div>

{{template "modern-footer" .}}
