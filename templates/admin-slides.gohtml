{{define "meta-robots"}}<meta name="robots" content="noindex, nofollow" />{{end}}
{{template "modern-header" .}}

<div class="admin-page">
    <!-- Header -->
    <div class="admin-header">
        <div class="admin-header-text">
            <h1>Slide Management</h1>
            <p>Create and manage DeckCraft presentations</p>
        </div>
        <div class="admin-header-actions">
            <a href="/slides" class="admin-btn-secondary">
                {{icon "external-link" "w-4 h-4"}}
                View Public Slides
            </a>
            <!-- New decks are DeckCraft decks (static/vendor/deckcraft), optionally starting from a .pptx. -->
            <form method="POST" action="/admin/slides" enctype="multipart/form-data" class="admin-header-actions">
                {{csrfField}}
                <input type="hidden" name="engine" value="deckcraft">
                <label for="new-deck-title" class="sr-only">Deck title</label>
                <input type="text" id="new-deck-title" name="title" required placeholder="Deck title" class="admin-input" style="width: 12rem;">
                <label class="admin-btn-secondary cursor-pointer">
                    {{icon "cloud-upload" "w-4 h-4"}}
                    <span id="new-deck-file-label">From PPTX (optional)</span>
                    <input type="file" id="new-deck-file" name="deck" accept=".pptx,.deckcraft" class="sr-only"
                           onchange="document.getElementById('new-deck-file-label').textContent = this.files[0] ? this.files[0].name : 'From PPTX (optional)'">
                </label>
                <button type="submit" class="admin-btn-primary">
                    {{icon "plus" "w-4 h-4"}}
                    New Slide
                </button>
            </form>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="admin-stats">
        <div class="admin-stat-card">
            <p class="admin-stat-label">Total Slides</p>
            <p class="admin-stat-value">{{len .Slides.Slides}}</p>
        </div>
        <div class="admin-stat-card">
            <p class="admin-stat-label">Published</p>
            <p class="admin-stat-value is-green">
                {{$published := 0}}{{range .Slides.Slides}}{{if .IsPublished}}{{$published = add $published 1}}{{end}}{{end}}{{$published}}
            </p>
        </div>
        <div class="admin-stat-card">
            <p class="admin-stat-label">Draft</p>
            <p class="admin-stat-value is-amber">
                {{$drafts := 0}}{{range .Slides.Slides}}{{if not .IsPublished}}{{$drafts = add $drafts 1}}{{end}}{{end}}{{$drafts}}
            </p>
        </div>
    </div>

    <!-- Slides List -->
    <div class="admin-card">
        <div class="admin-toolbar">
            <div class="admin-search-wrap">
                <span class="admin-search-icon">{{icon "search" "w-4 h-4"}}</span>
                <input type="search" id="searchInput" placeholder="Search slides by title or author..." class="admin-input">
            </div>
            {{if .IsAdmin}}
            <button id="bulkDeleteBtn" class="hidden admin-btn-danger" onclick="confirmBulkDelete()">
                {{icon "trash" "w-4 h-4"}}
                Delete Selected
            </button>
            {{end}}
        </div>

        {{if .Slides.Slides}}
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        {{if .IsAdmin}}<th scope="col" class="w-10">
                            <input type="checkbox" id="selectAll" class="admin-checkbox" onchange="toggleAllSelection()">
                        </th>{{end}}
                        <th scope="col">Slide</th>
                        <th scope="col">Author</th>
                        <th scope="col">Categories</th>
                        <th scope="col">Status</th>
                        <th scope="col">Created</th>
                        <th scope="col" class="is-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="slidesTableBody">
                    {{range .Slides.Slides}}
                    <tr class="slide-row" data-slide-id="{{.ID}}" data-searchable="{{.Title}} {{.Username}}">
                        {{if $.IsAdmin}}<td>
                            <input type="checkbox" class="slide-checkbox admin-checkbox" value="{{.ID}}" onchange="updateBulkDeleteButton()">
                        </td>{{end}}
                        <td class="admin-title-cell">
                            <a href="/admin/slides/{{.ID}}/edit" class="admin-title-link">{{.Title}}</a>
                            <div class="admin-subtext">
                                <a href="/slides/{{.Slug}}" style="color:inherit;">/slides/{{.Slug}}</a>
                            </div>
                        </td>
                        <td class="admin-secondary-cell">
                            {{.Username}}
                        </td>
                        <td>
                            <div class="admin-badge-list">
                                {{range .Categories}}
                                <span class="admin-badge admin-badge-accent">{{.Name}}</span>
                                {{end}}
                                {{if not .Categories}}
                                <span class="admin-muted">&mdash;</span>
                                {{end}}
                            </div>
                        </td>
                        <td>
                            <div class="admin-badge-list" style="align-items:center;">
                                {{if .IsPublished}}
                                <span class="admin-badge admin-badge-published">
                                    <span class="admin-badge-dot"></span>
                                    Published
                                </span>
                                {{else}}
                                <span class="admin-badge admin-badge-draft">
                                    <span class="admin-badge-dot"></span>
                                    Draft
                                </span>
                                {{end}}
                                {{if .PasswordHash}}
                                <span title="Password protected" class="admin-muted">{{icon "lock" "w-3.5 h-3.5"}}</span>
                                {{end}}
                                {{if .SlideCount}}
                                <span class="admin-muted text-xs">{{.SlideCount}}s</span>
                                {{end}}
                                {{if contains .SlideMetadata "pptx"}}
                                <span class="admin-badge admin-badge-orange">PPTX</span>
                                {{end}}
                            </div>
                        </td>
                        <td class="admin-num">
                            {{.CreatedAt}}
                        </td>
                        <td class="is-right">
                            <div class="admin-actions">
                                <a href="/slides/{{.Slug}}" target="_blank" class="admin-icon-btn" title="View slide" aria-label="View {{.Title}}">
                                    {{icon "eye" "w-4 h-4"}}
                                </a>
                                <a href="/admin/slides/{{.ID}}/edit" class="admin-icon-btn" title="Edit slide" aria-label="Edit {{.Title}}">
                                    {{icon "edit" "w-4 h-4"}}
                                </a>
                                {{if $.IsAdmin}}
                                <button type="button" onclick="deleteSingleSlide({{.ID}})" class="admin-icon-btn danger" title="Delete slide" aria-label="Delete {{.Title}}">
                                    {{icon "trash" "w-4 h-4"}}
                                </button>
                                {{end}}
                            </div>
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="admin-empty">
            <div class="admin-empty-icon">{{icon "columns" "w-10 h-10"}}</div>
            <h3>No slides yet</h3>
            <p>Get started by creating a new slide presentation above.</p>
            <a href="#new-deck-title" class="admin-btn-primary">
                {{icon "plus" "w-4 h-4"}}
                New Slide
            </a>
        </div>
        {{end}}
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="admin-modal-backdrop hidden">
    <div class="admin-modal" onclick="event.stopPropagation()">
        <div class="admin-modal-header">
            <h3 id="modalTitle">Delete Slide</h3>
            <button type="button" class="admin-icon-btn" onclick="closeDeleteModal()" aria-label="Close">
                {{icon "close" "w-5 h-5"}}
            </button>
        </div>
        <div class="admin-modal-body">
            <p id="modalMessage" class="text-sm" style="color: var(--text-secondary); margin: 0;">
                Are you sure you want to delete this slide? This action cannot be undone.
            </p>
        </div>
        <div class="admin-modal-footer">
            <button type="button" id="cancelDeleteBtn" class="admin-btn-secondary" onclick="closeDeleteModal()">Cancel</button>
            <button type="button" id="confirmDeleteBtn" class="admin-btn-danger">Delete</button>
        </div>
    </div>
</div>

<script>
// Search functionality
document.getElementById('searchInput').addEventListener('input', function(e) {
    const searchTerm = e.target.value.toLowerCase();
    const rows = document.querySelectorAll('.slide-row');

    rows.forEach(row => {
        const searchableText = row.getAttribute('data-searchable').toLowerCase();
        row.style.display = searchableText.includes(searchTerm) ? '' : 'none';
    });
});

// Multi-select functionality
function toggleAllSelection() {
    const selectAll = document.getElementById('selectAll');
    if (!selectAll) return;
    const checkboxes = document.querySelectorAll('.slide-checkbox');

    checkboxes.forEach(checkbox => {
        checkbox.checked = selectAll.checked;
    });

    updateBulkDeleteButton();
}

function updateBulkDeleteButton() {
    const checkedBoxes = document.querySelectorAll('.slide-checkbox:checked');
    const bulkDeleteBtn = document.getElementById('bulkDeleteBtn');
    const selectAll = document.getElementById('selectAll');

    if (bulkDeleteBtn) {
        if (checkedBoxes.length > 0) {
            bulkDeleteBtn.classList.remove('hidden');
            bulkDeleteBtn.classList.add('inline-flex');
        } else {
            bulkDeleteBtn.classList.add('hidden');
            bulkDeleteBtn.classList.remove('inline-flex');
        }
    }

    if (selectAll) {
        const allCheckboxes = document.querySelectorAll('.slide-checkbox');
        selectAll.checked = allCheckboxes.length > 0 && checkedBoxes.length === allCheckboxes.length;
        selectAll.indeterminate = checkedBoxes.length > 0 && checkedBoxes.length < allCheckboxes.length;
    }
}

// Delete functionality
let deleteTarget = null;
let deleteType = 'single';

function deleteSingleSlide(slideId) {
    deleteTarget = slideId;
    deleteType = 'single';
    document.getElementById('modalTitle').textContent = 'Delete Slide';
    document.getElementById('modalMessage').textContent = 'Are you sure you want to delete this slide? This action cannot be undone.';
    document.getElementById('deleteModal').classList.remove('hidden');
}

function confirmBulkDelete() {
    const checkedBoxes = document.querySelectorAll('.slide-checkbox:checked');
    deleteTarget = Array.from(checkedBoxes).map(cb => cb.value);
    deleteType = 'bulk';
    document.getElementById('modalTitle').textContent = 'Delete Slides';
    document.getElementById('modalMessage').textContent = `Are you sure you want to delete ${deleteTarget.length} slide(s)? This action cannot be undone.`;
    document.getElementById('deleteModal').classList.remove('hidden');
}

function closeDeleteModal() {
    document.getElementById('deleteModal').classList.add('hidden');
    deleteTarget = null;
    deleteType = 'single';
}

document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
    if (deleteType === 'single') {
        alert(`Delete slide ${deleteTarget} functionality not implemented yet`);
    } else if (deleteType === 'bulk') {
        alert(`Bulk delete ${deleteTarget.length} slides functionality not implemented yet`);
    }
    closeDeleteModal();
});

document.getElementById('deleteModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeDeleteModal();
    }
});

document.addEventListener('DOMContentLoaded', function() {
    updateBulkDeleteButton();
});
</script>

{{template "modern-footer" .}}
